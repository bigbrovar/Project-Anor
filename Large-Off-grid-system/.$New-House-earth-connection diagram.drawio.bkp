        </mxCell>
        <mxCell id="bCv8aPUlP1GbIQQmBcD9-15" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Main Earth Busbar&lt;br&gt;&lt;/span&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Everything connected to the earth rod (Including the ground wire from the PV array, satelite dish and starlink ground wire) connects through this earth busbar which is connected to the earth rod.&lt;/font&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="1" vertex="1">
          <mxGeometry x="810" y="660" width="280" height="300" as="geometry" />
        </mxCell>
        <mxCell id="bCv8aPUlP1GbIQQmBcD9-16" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Distrubution Board Earth Busbar&lt;br&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Earth bar from the electrical distribution board where every outlet ground is connected to.&lt;/span&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="1" vertex="1">
          <mxGeometry x="-140" y="260" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="bCv8aPUlP1GbIQQmBcD9-17" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Busbar for SCC &amp;amp; Inverter&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Ground wire from the inverter AC input / output, and the PV combiner box are connected here.&lt;/span&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="1" vertex="1">
          <mxGeometry x="-40" y="580" width="280" height="180" as="geometry" />
        </mxCell>
        <mxCell id="bCv8aPUlP1GbIQQmBcD9-18" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Connection point for the db busbar and solar / inverter busbar. It is also the connection point for the inverter spd busbar&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="1" vertex="1">
