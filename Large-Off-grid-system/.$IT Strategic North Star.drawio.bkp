        <mxCell id="KY2pqhS_SPfNfra4FVJn-16" value="&lt;ul style=&quot;font-size: 14px;&quot;&gt;&lt;li&gt;&lt;b&gt;&lt;u&gt;Improve Operational Efficiency&lt;/u&gt;:&lt;/b&gt; Improve processes and systems to increase productivity and reduce cost&lt;/li&gt;&lt;li&gt;&lt;b&gt;&lt;u&gt;Ensuring Security and Compliance:&lt;/u&gt; &lt;/b&gt;Secure paystack information system from threats &amp;amp; ensuring compliance with regulation and standards.&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;b&gt;&lt;u&gt;Driving Innovation:&lt;/u&gt;&lt;/b&gt; Implement new technological solutions&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;b&gt;&lt;u&gt;Improving User experience:&lt;/u&gt;&lt;/b&gt; Improve user experience with IT systems through improved service IT Service delivery and Support&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;b&gt;&lt;u&gt;IT Infrastructure reliability,&lt;/u&gt; availability and scalability&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;glass=0;shadow=1;sketch=1;curveFitting=1;jiggle=2;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="1" vertex="1">
