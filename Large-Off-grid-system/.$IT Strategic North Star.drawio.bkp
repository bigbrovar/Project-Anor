        <mxCell id="KY2pqhS_SPfNfra4FVJn-24" value="&lt;ul&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Ensure 100% Endpoint Device Management of Work issued laptop&lt;br&gt;&lt;br&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Enforce Password security on endpoint device&lt;br&gt;&lt;br&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Enforce security standard on web browsers for endpoint computers&lt;br&gt;&lt;br&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Enforce security stands on BYOD devices that access paystack data - info systems&lt;br&gt;&lt;br&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Enforcement of security standards on endpoint devices used by 3rd parties on paystack information system.&lt;br&gt;&lt;br&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;link Adaptive user verification and security check to Authentication&lt;br&gt;&lt;br&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Integration of device verification to SSO authentication&lt;br&gt;&lt;br&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Improve user access off-boarding SLA to 8 hours&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;gradientColor=none;sketch=1;curveFitting=1;jiggle=2;shadow=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="1" vertex="1">
