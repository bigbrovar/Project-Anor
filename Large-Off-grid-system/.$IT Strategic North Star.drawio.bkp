        <mxCell id="KY2pqhS_SPfNfra4FVJn-22" value="&lt;font style=&quot;font-size: 21px;&quot;&gt;&lt;b&gt;2024 H2 Priorties&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="1" vertex="1">
